{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FileTransferEvent",
  "type": "object",
  "required": [
    "eventVersion",
    "eventId",
    "correlationId",
    "timestamp",
    "source",
    "destination"
  ],
  "properties": {
    "eventVersion": {
      "type": "string"
    },
    "eventId": {
      "type": "string"
    },
    "correlationId": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "bucket": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "destination": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "bucket": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    }
  }
}
